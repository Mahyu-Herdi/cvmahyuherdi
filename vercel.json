{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/undangan-resepsi",
      "dest": "https://luxury-undangan-resepsi.vercel.app"
    },
    {
      "src": "/undangan-resepsi/(.*)",
      "dest": "https://luxury-undangan-resepsi.vercel.app/$1"
    },
    {
      "src": "/(favicon.png|foto.png|src/.*)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
