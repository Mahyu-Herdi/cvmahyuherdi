rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny safety net untuk seluruh path lain
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Helper autentikasi, validasi ID, payload, dan Admin
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn()
        && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isAdmin() {
      return isVerifiedUser()
        && request.auth.token.email == 'erbeawebird@gmail.com';
    }

    // 3. Validasi ketat struktur, kepemilikan UID, tipe, panjang teks, rating 1-5, dan server timestamp
    function isValidTestimonial(data) {
      return data.keys().hasAll(['authorUid', 'name', 'title', 'message', 'rating', 'createdAt'])
        && data.keys().hasOnly(['authorUid', 'name', 'title', 'message', 'rating', 'createdAt'])
        && data.authorUid is string
        && data.authorUid == request.auth.uid
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 60
        && data.title is string
        && data.title.size() >= 2
        && data.title.size() <= 80
        && data.message is string
        && data.message.size() >= 10
        && data.message.size() <= 500
        && data.rating is int
        && data.rating >= 1
        && data.rating <= 5
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    function isValidTestimonialEmail(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt'])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.email is string
        && data.email == request.auth.token.email
        && data.email.size() >= 3
        && data.email.size() <= 160
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    // 4. Aturan akses koleksi ulasan & rating publik (1 Akun Google = 1 Ulasan, tanpa email)
    match /testimonials/{reviewId} {
      // Publik dapat membaca ulasan dan menampilkan rating di halaman web
      allow get: if isValidId(reviewId);
      allow list: if true;

      // Wajib login Google terverifikasi, ID dokumen dikunci ke UID akun (1 akun = 1 ulasan)
      allow create: if isVerifiedUser()
        && isValidId(reviewId)
        && reviewId == request.auth.uid
        && isValidTestimonial(incoming());

      // Tidak bisa diedit ulang oleh publik (anti-manipulasi rating/isi ulasan)
      allow update: if false;

      // Penghapusan oleh Admin terverifikasi (atau langsung manual dari Firebase Console)
      allow delete: if isAdmin();
    }

    // 5. Koleksi privat email pengirim ulasan (terisolasi khusus Admin / Firebase Console)
    match /testimonial_emails/{userId} {
      // Hanya Admin yang dapat membaca daftar email pengirim ulasan
      allow get: if isValidId(userId) && isAdmin();
      allow list: if isAdmin();

      // Hanya dapat dibuat bersamaan dengan pembuatan ulasan di /testimonials/{uid}
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidTestimonialEmail(incoming())
        && existsAfter(/databases/$(database)/documents/testimonials/$(userId));

      // Hanya boleh diperbarui jika ulasan di /testimonials/{uid} sebelumnya dihapus Admin dan user menulis ulasan baru
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidTestimonialEmail(incoming())
        && incoming().uid == existing().uid
        && !exists(/databases/$(database)/documents/testimonials/$(userId))
        && existsAfter(/databases/$(database)/documents/testimonials/$(userId));

      // Penghapusan oleh Admin terverifikasi (atau langsung manual dari Firebase Console)
      allow delete: if isAdmin();
    }
  }
}
